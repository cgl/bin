[user]
    name = Çağıl Uluşahin
	email = cagilulusahin@gmail.com
	signingkey = /Users/cagil/.ssh/id_ed25519.pub
	name = Cagil

[color]
    ui = auto

[color "branch"]
    current = yellow reverse
    local = yellow
    remote = green

[color "diff"]
    whitespace = red reverse
    meta = yellow bold
    frag = magenta bold
    old = red bold
    new = green bold

[color "status"]
    added = yellow
    changed = green
    untracked = cyan

[core]
    whitespace = fix,-indent-with-non-tab,trailing-space,cr-at-eol
    editor = ec
    #    pager = delta

[interactive]

[alias]
    st = status
    ci = commit
    br = branch
    co = checkout
    df = diff
    dc = diff --cached
    dn = diff --name-only
    udn = diff --name-only @{u}
    udf = diff @{u}
    fe = fetch
    lg = log -p
    lol = log --graph --decorate --pretty=oneline --abbrev-commit
    lola = log --graph --decorate --pretty=oneline --abbrev-commit --all
    ls = ls-files
    p = push
    # Show files ignored by git:
    ign = ls-files -o -i --exclude-standard

    # Show verbose output about tags, branches or remotes
    tags = tag -l
    branches = branch -a
    remotes = remote -v

    # Pretty log output
    hist = log --graph --pretty=format:'%Cred%h%Creset %s%C(yellow)%d%Creset %Cgreen(%cr)%Creset [%an]' --abbrev-commit --date=relative

[push]
    default = current

# Use `origin` as the default remote on the `main` branch.
[branch "main"]
    remote = origin
    merge = refs/heads/main

[commit]
    gpgsign = true
    template = /Users/cagilsonmez/.git_commit_msg.txt

[gpg]
    program = /usr/local/bin/gpg
    format = ssh

[rebase]
    autosquash = false

[grep]
    lineNumber = true
    column = false

[merge]
    tool = ediff

[mergetool "ediff"]
    cmd = emacsclient -c -a \"\" --eval \"(ediff-merge-files-with-ancestor \\\"$LOCAL\\\" \\\"$REMOTE\\\" \\\"$BASE\\\" nil \\\"$MERGED\\\")\"

[gpg "ssh"]
    allowedSignersFile = /Users/cagilsonmez/.ssh/allowed_signers
    program = ssh-keygen

[delta]
    navigate = true
    light = false
    side-by-side = true
    features = solarized-dark
